# ============================================================
# EduNation — Variables d'environnement
# Copier vers .env.local en local
# Configurer dans Vercel > Project > Settings > Environment Variables
# ============================================================

# --- Supabase (obligatoire) ---
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App (obligatoire en production) ---
# Local :
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production Vercel (remplacer par votre domaine) :
# NEXT_PUBLIC_APP_URL=https://edunation.vercel.app

# --- Resend (recommandé — emails transactionnels) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=EduNation <noreply@votredomaine.com>

# --- Optionnel ---
# SMS_PROVIDER_API_KEY=

# ============================================================
# Checklist déploiement Vercel + Supabase
# ============================================================
#
# 1. Vercel : importer le repo Git, région fra1 (déjà dans vercel.json)
# 2. Vercel : ajouter toutes les variables ci-dessus (Production + Preview)
# 3. Supabase Auth > URL Configuration :
#    - Site URL : https://votre-domaine.vercel.app
#    - Redirect URLs :
#      https://votre-domaine.vercel.app/**
#      https://*.vercel.app/**
# 4. Supabase Auth > SMTP (via Resend, domaine algocodebf.com) :
#    Host smtp.resend.com | Port 465 | User resend | Password RESEND_API_KEY
#    Sender : EduNation <noreply@algocodebf.com>
# 5. Supabase Auth > Email Templates (design EduNation) :
#    npm run email:generate-supabase
#    Copier supabase/email-templates/*.html dans Authentication > Email Templates
# 6. Appliquer les migrations SQL (001, 002, 003) dans Supabase SQL Editor
# 7. Redéployer après modification des variables d'environnement
