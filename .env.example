# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (API routes, admin client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Domaine verifie sur Resend (ex: noreply@votredomaine.com)
EMAIL_FROM=EduNation <noreply@votredomaine.com>

# Optional
# SMS_PROVIDER_API_KEY=

# Pour les emails Auth Supabase (confirmation, reset password) :
# Dashboard Supabase > Authentication > SMTP Settings
# Host: smtp.resend.com | Port: 465 | User: resend | Password: votre RESEND_API_KEY
